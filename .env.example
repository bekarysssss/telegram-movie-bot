# --- Telegram ---
BOT_TOKEN=123456:replace-with-token-from-BotFather
BOT_NAME=Movie Finder
# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# --- База данных ---
POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_DB=movies
# В docker-compose хост = postgres, локально = localhost
DATABASE_URL=postgresql+asyncpg://movies:movies@postgres:5432/movies
# Пусто = FSM в памяти (состояния потеряются при рестарте)
REDIS_URL=redis://redis:6379/0

# --- TMDB (https://www.themoviedb.org/settings/api) ---
# Подходит и v3 API key, и v4 "API Read Access Token"
TMDB_API_KEY=

# --- Веб-админка (http://localhost:8000/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# --- Настройки выдачи ---
PER_PAGE=8
# Минимум голосов, чтобы фильм попал в списки «по рейтингу»
MIN_VOTES=1000
